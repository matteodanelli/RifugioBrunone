---
import { Image, getImage } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import heroSource from '../assets/images/hero.jpg';
import facebookIcon from '../assets/images/Facebook_Logo_Primary.png';

const hero = await getImage({ src: heroSource, format: 'webp', width: Math.min(heroSource.width, 2000) });
---

<Layout title="Home">
  <section
    class="relative flex min-h-[420px] flex-col items-start justify-start gap-4 overflow-hidden rounded-2xl bg-cover bg-center p-6 sm:min-h-[520px] sm:p-10"
    style={`background-image: url(${hero.src})`}
  >
    <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/20 to-transparent" aria-hidden="true"></div>
    <a
      href="https://www.facebook.com/Rifugio-Brunone-855063957954205"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
      class="absolute right-4 top-4 transition-opacity hover:opacity-80 sm:right-6 sm:top-6"
    >
      <Image src={facebookIcon} alt="" format="webp" width={32} height={32} class="h-8 w-8" />
    </a>
    <div class="relative flex flex-col items-start gap-4">
      <p class="font-display text-sm uppercase tracking-widest text-black">Valbondione &middot; 2297 m</p>
      <h1 class="font-display text-4xl font-semibold text-black sm:text-5xl">Rifugio Brunone</h1>
      <p class="max-w-2xl text-lg text-black">
        Tra il pizzo del Diavolo di Tenda &mdash; il &laquo;Cervino bergamasco&raquo; &mdash; e l'incantevole pizzo
        Redorta, dal 1879 il rifugio Antonio Baroni al Brunone offre l'ospitalità delle sue solide mura agli
        escursionisti delle Orobie.
      </p>
    </div>
  </section>

  {/* Gli avvisi non sono più build-time (Content Collection Markdown): li scrive e
      cancella il gestore da /admin/, quindi vanno letti a runtime dal Worker
      (worker/index.ts, GET /api/avvisi) — altrimenti servirebbe un rebuild+deploy a ogni
      avviso pubblicato. Sezione nascosta finché non c'è almeno un avviso da mostrare. */}
  <section id="avvisi-section" class="mt-12 hidden">
    <h2 class="font-display text-xl font-semibold text-brunone-800">Avvisi</h2>
    <div id="avvisi-list" class="mt-3 space-y-4"></div>
  </section>
</Layout>

<script>
  interface Avviso {
    id: number;
    title: string;
    text: string;
    date: string;
    important: number;
  }

  async function loadAvvisi() {
    const section = document.getElementById('avvisi-section');
    const list = document.getElementById('avvisi-list');
    if (!section || !list) return;

    try {
      const res = await fetch('/api/avvisi');
      if (!res.ok) throw new Error();
      const avvisi = (await res.json()) as Avviso[];
      if (avvisi.length === 0) return;

      for (const avviso of avvisi) {
        const article = document.createElement('article');
        article.className = 'rounded-lg border border-brunone-200 bg-white/60 p-5';
        article.innerHTML = `
          <div class="flex items-center gap-3">
            ${avviso.important ? '<span class="rounded bg-sunset/10 px-2 py-0.5 text-xs font-semibold text-sunset">importante</span>' : ''}
            <h3 class="font-display text-lg font-semibold text-brunone-900"></h3>
          </div>
          <time class="mt-1 block text-xs text-brunone-500"></time>
          <p class="mt-3 text-sm text-brunone-700"></p>
        `;
        article.querySelector('h3')!.textContent = avviso.title;
        const time = article.querySelector('time')!;
        time.dateTime = avviso.date;
        time.textContent = new Date(avviso.date).toLocaleDateString('it-IT', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
        article.querySelector('p')!.textContent = avviso.text;
        list.appendChild(article);
      }

      section.classList.remove('hidden');
    } catch {
      // Nessun avviso disponibile (o Worker/D1 non ancora configurati in questo
      // ambiente, es. `astro dev` in locale): la sezione resta semplicemente nascosta.
    }
  }

  loadAvvisi();
</script>

