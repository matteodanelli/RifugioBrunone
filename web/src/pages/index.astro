---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const avvisi = (await getCollection('avvisi'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const cards = [
  {
    href: '/dove-siamo/',
    title: 'Dove siamo',
    text: 'I sentieri CAI per raggiungere il rifugio, da Fiumenero e dai rifugi vicini.',
  },
  {
    href: '/il-rifugio/',
    title: 'Il rifugio',
    text: 'Dal 1879 a oggi: la storia della Brunona sotto il passo della Scaletta.',
  },
  {
    href: '/immagini/',
    title: 'Immagini',
    text: 'Panorami, vita al rifugio, flora e fauna delle Orobie bergamasche.',
  },
];
---

<Layout title="Home">
  <section class="flex flex-col items-start gap-6 py-8 sm:py-16">
    <p class="font-display text-sm uppercase tracking-widest text-brunone-600">Valbondione &middot; 2297 m</p>
    <h1 class="font-display text-4xl font-semibold text-brunone-900 sm:text-5xl">Rifugio Brunone</h1>
    <p class="max-w-2xl text-lg text-brunone-800">
      Tra il pizzo del Diavolo di Tenda &mdash; il &laquo;Cervino bergamasco&raquo; &mdash; e l'incantevole pizzo
      Redorta, dal 1879 il rifugio Antonio Baroni al Brunone offre l'ospitalità delle sue solide mura agli
      escursionisti delle Orobie.
    </p>
    <a
      href="/contatti/"
      class="rounded-md bg-brunone-700 px-5 py-2.5 font-medium text-white transition-colors hover:bg-brunone-800"
    >
      Contatta il gestore
    </a>
  </section>

  {avvisi.length > 0 && (
    <section class="rounded-lg border border-brunone-200 bg-white/60 p-5">
      <h2 class="font-display text-xl font-semibold text-brunone-800">Ultimi avvisi</h2>
      <ul class="mt-3 space-y-2">
        {avvisi.map((avviso) => (
          <li class="flex items-baseline gap-3">
            {avviso.data.important && (
              <span class="rounded bg-sunset/10 px-2 py-0.5 text-xs font-semibold text-sunset">importante</span>
            )}
            <span class="font-medium text-brunone-900">{avviso.data.title}</span>
          </li>
        ))}
      </ul>
      <a href="/avvisi/" class="mt-3 inline-block text-sm font-medium text-brunone-700 hover:underline">
        Vedi tutti gli avvisi &rarr;
      </a>
    </section>
  )}

  <section class="mt-12 grid gap-6 sm:grid-cols-3">
    {cards.map((card) => (
      <a
        href={card.href}
        class="rounded-lg border border-brunone-200 bg-white/60 p-5 transition-shadow hover:shadow-md"
      >
        <h3 class="font-display text-lg font-semibold text-brunone-800">{card.title}</h3>
        <p class="mt-2 text-sm text-brunone-700">{card.text}</p>
      </a>
    ))}
  </section>
</Layout>
