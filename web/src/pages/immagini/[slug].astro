---
import Layout from '../../layouts/Layout.astro';
import { GALLERIES } from '../../data/galleries';

export function getStaticPaths() {
  return GALLERIES.filter((g) => g.migrated).map((g) => ({
    params: { slug: g.slug },
    props: { gallery: g },
  }));
}

const { gallery } = Astro.props;
const photos = Array.from({ length: gallery.count }, (_, i) => i + 1);
---

<Layout title={gallery.title} description={`Galleria fotografica: ${gallery.title}.`}>
  <a href="/immagini/" class="text-sm text-brunone-600 hover:underline">&larr; Tutte le gallerie</a>
  <h1 class="mt-2 font-display text-3xl font-semibold text-brunone-900">{gallery.title}</h1>

  <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3">
    {photos.map((n) => (
      <a
        href={`/photos/${gallery.slug}/original/${n}.jpg`}
        data-lightbox={gallery.slug}
        class="gallery-link block overflow-hidden rounded-lg border border-brunone-200"
      >
        <img
          src={`/photos/${gallery.slug}/thumb/${n}.jpg`}
          alt={`${gallery.title} ${n}`}
          loading="lazy"
          class="aspect-square w-full object-cover transition-transform hover:scale-105"
        />
      </a>
    ))}
  </div>
</Layout>

<!-- Lightbox minimale in vanilla JS: sostituisce jQuery 1.10 + lightbox-2.6.min.js -->
<dialog id="lightbox" class="max-w-3xl rounded-lg bg-transparent p-0 backdrop:bg-black/80">
  <img id="lightbox-img" src="" alt="" class="max-h-[85vh] w-full rounded-lg object-contain" />
</dialog>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;

  document.querySelectorAll<HTMLAnchorElement>('.gallery-link').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      if (!dialog || !img) return;
      img.src = link.href;
      img.alt = link.querySelector('img')?.alt ?? '';
      dialog.showModal();
    });
  });

  dialog?.addEventListener('click', () => dialog.close());
</script>
