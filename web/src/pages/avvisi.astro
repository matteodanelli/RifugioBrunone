---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

// In passato: GestoreAvvisiServlet scriveva su App Engine Datastore e avvisi.jsp
// interrogava il Datastore a ogni richiesta. Ora sono semplici file Markdown
// nella content collection "avvisi" (vedi src/content.config.ts), letti a build
// time: niente più servlet, niente più datastore da pagare/mantenere.
const avvisi = (await getCollection('avvisi')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const importanti = avvisi.filter((a) => a.data.important);
const altri = avvisi.filter((a) => !a.data.important);
---

<Layout title="Avvisi" description="Avvisi e comunicazioni dal rifugio Brunone.">
  <h1 class="font-display text-3xl font-semibold text-brunone-900">Avvisi</h1>

  {avvisi.length === 0 && <p class="mt-4 text-brunone-700">Al momento non sono presenti avvisi.</p>}

  <div class="mt-6 space-y-4">
    {[...importanti, ...altri].map(async (avviso) => {
      const { Content } = await render(avviso);
      return (
        <article class="rounded-lg border border-brunone-200 bg-white/60 p-5">
          <div class="flex items-center gap-3">
            {avviso.data.important && (
              <span class="rounded bg-sunset/10 px-2 py-0.5 text-xs font-semibold text-sunset">importante</span>
            )}
            <h2 class="font-display text-lg font-semibold text-brunone-800">{avviso.data.title}</h2>
          </div>
          <time class="mt-1 block text-xs text-brunone-500" datetime={avviso.data.date.toISOString()}>
            {avviso.data.date.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <div class="prose prose-sm mt-3 max-w-none text-brunone-700">
            <Content />
          </div>
        </article>
      );
    })}
  </div>
</Layout>
