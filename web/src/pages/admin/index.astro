---
import Layout from '../../layouts/Layout.astro';

// Pagina volutamente non collegata nella navigazione (src/data/nav.ts): ci si arriva solo
// con l'URL diretto /admin/, protetto da Cloudflare Access (configurato nella dashboard
// Cloudflare, non qui — vedi README.md). Tutta la logica di lettura/scrittura avvisi
// gira lato client contro il Worker (worker/index.ts, rotte /admin/api/*).
---

<Layout title="Gestione avvisi" description="Area riservata al gestore del rifugio.">
  <h1 class="font-display text-3xl font-semibold text-brunone-900">Gestione avvisi</h1>
  <p id="whoami" class="mt-1 text-sm text-brunone-600"></p>

  <form id="new-avviso" class="mt-8 grid gap-4 rounded-lg border border-brunone-200 bg-white/60 p-5 sm:grid-cols-2">
    <label class="flex flex-col gap-1 text-sm sm:col-span-2">
      Titolo
      <input required name="title" type="text" class="rounded border border-brunone-200 px-3 py-2" />
    </label>
    <label class="flex flex-col gap-1 text-sm">
      Data
      <input required name="date" type="date" class="rounded border border-brunone-200 px-3 py-2" />
    </label>
    <label class="flex flex-col gap-1 text-sm sm:col-span-2">
      Testo
      <textarea required name="text" rows="4" class="rounded border border-brunone-200 px-3 py-2"></textarea>
    </label>
    <button
      type="submit"
      class="rounded-md bg-brunone-700 px-5 py-2.5 font-medium text-white transition-colors hover:bg-brunone-800 sm:col-span-2 sm:w-fit"
    >
      Pubblica avviso
    </button>
    <p id="new-avviso-status" class="text-sm sm:col-span-2" role="status"></p>
  </form>

  <h2 class="mt-10 font-display text-xl font-semibold text-brunone-800">Avvisi pubblicati</h2>
  <div id="avvisi-list" class="mt-4 space-y-3">
    <p class="text-sm text-brunone-600">Caricamento…</p>
  </div>
</Layout>

<script>
  interface Avviso {
    id: number;
    title: string;
    text: string;
    date: string;
  }

  const listEl = document.getElementById('avvisi-list');
  const whoamiEl = document.getElementById('whoami');
  const form = document.getElementById('new-avviso') as HTMLFormElement | null;
  const statusEl = document.getElementById('new-avviso-status');

  async function loadWhoami() {
    if (!whoamiEl) return;
    try {
      const res = await fetch('/admin/api/whoami');
      if (!res.ok) throw new Error();
      const { email } = (await res.json()) as { email: string };
      whoamiEl.textContent = `Connesso come: ${email}`;
    } catch {
      whoamiEl.textContent = '';
    }
  }

  async function loadAvvisi() {
    if (!listEl) return;
    listEl.innerHTML = '<p class="text-sm text-brunone-600">Caricamento…</p>';
    try {
      const res = await fetch('/admin/api/avvisi');
      if (!res.ok) throw new Error('Richiesta non autorizzata o fallita');
      const avvisi = (await res.json()) as Avviso[];

      if (avvisi.length === 0) {
        listEl.innerHTML = '<p class="text-sm text-brunone-600">Nessun avviso pubblicato.</p>';
        return;
      }

      listEl.innerHTML = '';
      for (const avviso of avvisi) {
        const article = document.createElement('article');
        article.className = 'rounded-lg border border-brunone-200 bg-white/60 p-4';
        article.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-lg font-semibold text-brunone-900"></h3>
              <time class="mt-1 block text-xs text-brunone-500"></time>
              <p class="mt-2 text-sm text-brunone-700"></p>
            </div>
            <button type="button" class="shrink-0 rounded border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50">
              Elimina
            </button>
          </div>
        `;
        article.querySelector('h3')!.textContent = avviso.title;
        article.querySelector('time')!.textContent = new Date(avviso.date).toLocaleDateString('it-IT', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        });
        article.querySelector('p')!.textContent = avviso.text;
        article.querySelector('button')!.addEventListener('click', async () => {
          if (!confirm(`Eliminare l'avviso "${avviso.title}"?`)) return;
          await fetch(`/admin/api/avvisi/${avviso.id}`, { method: 'DELETE' });
          await loadAvvisi();
        });
        listEl.appendChild(article);
      }
    } catch {
      listEl.innerHTML =
        '<p class="text-sm text-red-700">Impossibile caricare gli avvisi. Verifica di aver effettuato l\'accesso.</p>';
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!statusEl) return;
    statusEl.textContent = 'Pubblicazione in corso…';
    const data = new FormData(form);
    try {
      const res = await fetch('/admin/api/avvisi', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          title: data.get('title'),
          date: data.get('date'),
          text: data.get('text'),
        }),
      });
      if (!res.ok) throw new Error();
      statusEl.textContent = 'Avviso pubblicato.';
      form.reset();
      await loadAvvisi();
    } catch {
      statusEl.textContent = 'Pubblicazione non riuscita: riprova.';
    }
  });

  loadWhoami();
  loadAvvisi();
</script>
