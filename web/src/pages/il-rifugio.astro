---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { GALLERIES } from '../data/galleries';
import old4 from '../assets/images/old4.jpg';
import old5 from '../assets/images/old5.jpg';

// Tutte le foto vivono in src/assets/photos/<slug>/{thumb,original}/<n>.jpg (copiate 1:1 dal
// vecchio src/main/webapp/photos/, una cartella per ciascuna delle vecchie pagine
// panorami.html, vitaalrifugio.html, ecc.). Il glob le porta nella pipeline immagini di
// Astro: da qui vengono ridimensionate e convertite in WebP. Prima erano su pagine separate
// sotto /immagini/, ora tutte qui sotto "Fotografie".
const allPhotos = import.meta.glob('/src/assets/photos/**/*.jpg', { eager: true }) as Record<
  string,
  { default: ImageMetadata }
>;

function getPhoto(slug: string, kind: 'thumb' | 'original', n: number) {
  const key = `/src/assets/photos/${slug}/${kind}/${n}.jpg`;
  const mod = allPhotos[key];
  if (!mod) throw new Error(`Foto non trovata: ${key}`);
  return mod.default;
}

const galleries = GALLERIES.filter((gallery) => !gallery.hidden).map((gallery) => ({
  ...gallery,
  photos: Array.from({ length: gallery.count }, (_, i) => i + 1).map((n) => {
    const original = getPhoto(gallery.slug, 'original', n);
    return { n, original, originalWidth: Math.min(original.width, 1600) };
  }),
}));
---

<Layout title="Il rifugio" description="La storia e le fotografie del rifugio Antonio Baroni al Brunone, dal 1879 a oggi.">
  <div class="relative mt-6">
    <div class="photo-loader absolute inset-0 flex items-center justify-center rounded-lg bg-brunone-100">
      <svg class="h-8 w-8 animate-spin text-brunone-400" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    </div>
    <Image
      src={old4}
      alt="La vecchia capanna della Brunona"
      width={Math.min(old4.width, 1600)}
      format="webp"
      loading="lazy"
      class="photo-img relative w-full rounded-lg opacity-0 transition-opacity duration-300"
    />
  </div>

  <div class="prose prose-brunone mt-8 max-w-none text-brunone-800">
    <p>
      La prima capanna della Brunona risale al 1879, ricavata da una vecchia baita di minatori che lavoravano nelle
      miniere di ferro, in prossimità del vicino Passo della Scaletta. Fu durante la gita sociale del CAI di
      Bergamo al Pizzo Redorta, il 29 luglio 1890, che i soci, costretti dal maltempo a ripararsi nella vecchia
      capanna, si resero conto del suo stato di abbandono e decisero di sostituirla.
    </p>
    <p>
      Una decisione formalizzata nell'assemblea sociale del febbraio 1894; poche settimane dopo iniziarono i
      lavori. Completati in 3 mesi, portarono all'inaugurazione del &laquo;Rifugio della Brunona&raquo;, come venne
      chiamato all'epoca, il 23 settembre 1894. Il progetto del 1894, dovuto all'ingegnere Luigi Albani, fa sorgere
      il rifugio poco più in basso rispetto al capanno dei minatori.
    </p>
    <p>
      In seguito il rifugio venne ristrutturato e dedicato, nel 1968, alla guida alpina Antonio Baroni. Attualmente
      il rifugio Brunone è rimasto nella collocazione del 1894, a quota 2297&nbsp;m su una meravigliosa terrazza
      erbosa, sotto il passo della Scaletta, con una visuale che spazia dalla cima del Pizzo Redorta alla parete
      orientale del pizzo del Diavolo di Tenda.
    </p>
  </div>

  <div class="relative mt-8">
    <div class="photo-loader absolute inset-0 flex items-center justify-center rounded-lg bg-brunone-100">
      <svg class="h-8 w-8 animate-spin text-brunone-400" viewBox="0 0 24 24" fill="none">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
      </svg>
    </div>
    <Image
      src={old5}
      alt="Il rifugio oggi"
      width={Math.min(old5.width, 1600)}
      format="webp"
      loading="lazy"
      class="photo-img relative w-full rounded-lg opacity-0 transition-opacity duration-300"
    />
  </div>

  <h2 class="mt-16 font-display text-3xl font-semibold text-brunone-900">Fotografie</h2>

  <div class="mt-8 space-y-10">
    {galleries.map((gallery) => (
      <div>
        <h3 class="font-display text-xl font-semibold text-brunone-800">{gallery.title}</h3>
        {/* Slideshow: una foto alla volta invece della griglia con tutte le miniature —
            più leggibile per le gallerie con decine di foto (Panorami ne ha 36). Mostra
            direttamente la foto a piena risoluzione (non più una miniatura sgranata con
            click per ingrandire): "loading=lazy" fa sì che il browser non scarichi le foto
            nascoste (display:none) finché non diventano la slide attiva — evita di
            scaricare tutte le foto della galleria in una volta. Uno spinner copre ogni
            foto finché non ha finito di caricare. */}
        <div class="relative mt-4 overflow-hidden rounded-lg border border-brunone-200" data-slider={gallery.slug}>
          {gallery.photos.map(({ n, original, originalWidth }, i) => (
            <div
              class:list={[
                'slide relative flex h-80 items-center justify-center bg-brunone-100 sm:h-[480px]',
                i !== 0 && 'hidden',
              ]}
              data-index={i}
            >
              {/* object-contain (invece di object-cover) + max-h/max-w-full: la foto si
                  vede per intero, senza tagli — importante per quelle verticali, che con
                  un riquadro fisso in stile "cover" perderebbero testa/piedi. Lo spazio
                  avanzato ai lati (o sopra/sotto) resta del colore di sfondo del riquadro. */}
              <div class="photo-loader absolute inset-0 flex items-center justify-center">
                <svg class="h-8 w-8 animate-spin text-brunone-400" viewBox="0 0 24 24" fill="none">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                </svg>
              </div>
              <Image
                src={original}
                alt={`${gallery.title} ${n}`}
                width={originalWidth}
                format="webp"
                loading="lazy"
                class="photo-img relative max-h-full max-w-full object-contain opacity-0 transition-opacity duration-300"
              />
            </div>
          ))}

          {gallery.photos.length > 1 && (
            <>
              <button
                type="button"
                class="slider-prev absolute left-2 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white transition-colors hover:bg-black/70"
                aria-label="Foto precedente"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                type="button"
                class="slider-next absolute right-2 top-1/2 -translate-y-1/2 rounded-full bg-black/50 p-2 text-white transition-colors hover:bg-black/70"
                aria-label="Foto successiva"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
              <p class="slider-counter absolute bottom-2 right-2 rounded bg-black/50 px-2 py-0.5 text-xs text-white">
                1 / {gallery.photos.length}
              </p>
            </>
          )}
        </div>
      </div>
    ))}
  </div>
</Layout>

<script>
  // Slideshow per gallery: mostra una .slide alla volta invece della griglia completa,
  // a piena risoluzione.
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((slider) => {
    const slides = Array.from(slider.querySelectorAll<HTMLElement>('.slide'));
    const counter = slider.querySelector<HTMLElement>('.slider-counter');
    let current = 0;

    function show(index: number) {
      slides[current]?.classList.add('hidden');
      current = (index + slides.length) % slides.length;
      slides[current]?.classList.remove('hidden');
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
    }

    slider.querySelector('.slider-prev')?.addEventListener('click', () => show(current - 1));
    slider.querySelector('.slider-next')?.addEventListener('click', () => show(current + 1));
  });

  // Nasconde lo spinner di ogni foto non appena ha finito di caricare. Uso l'evento
  // "load" (non decode()): decode() forzerebbe subito il download anche delle foto
  // ancora nascoste (le altre slide di ogni galleria), vanificando "loading=lazy".
  document.querySelectorAll<HTMLImageElement>('.photo-img').forEach((photo) => {
    const reveal = () => {
      photo.classList.remove('opacity-0');
      photo.previousElementSibling?.classList.add('hidden');
    };
    if (photo.complete) reveal();
    photo.addEventListener('load', reveal);
  });
</script>
